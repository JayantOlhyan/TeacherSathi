# =============================================================================
# TeacherSathi — Environment Configuration Template
# =============================================================================

# 1. Supabase Client Configuration (Exposed to Browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# 2. Supabase Server Configuration (SERVER-SIDE ONLY — NEVER EXPOSE TO BROWSER)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# 3. Direct PostgreSQL Connection String (For Migrations & Direct Seeding)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-id.supabase.co:5432/postgres

# 4. Optional / Future Integrations (Phase 3 & Phase 4)
# NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
# YOUTUBE_API_KEY=your-youtube-data-api-key
